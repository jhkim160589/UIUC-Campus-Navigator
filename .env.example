# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://navigator:navigator@localhost:5432/campus_navigator

# UIUC course API (public, no auth)
CIS_BASE_URL=https://courses.illinois.edu/cisapp/explorer/schedule
CIS_YEAR=2026
CIS_TERM=fall

# Google APIs - only needed for geocoding (one-off) and Week 5 validation.
# Leave blank until you actually need them.
GOOGLE_MAPS_API_KEY=
